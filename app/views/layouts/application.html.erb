<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
"https://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html lang="us" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <title><%= @page_title || 'Dream Library' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <header>
      <div id="header-wrapper">
        <div id="header">
          <div  id="logo">
            <h1>Dream<br> Library&trade;</h1>
          </div>

          <div id="nav-searchbox-icon-menu">
            <div id="nav-searchbox-hamburgermenu-icon">
              <%= render "layouts/search_box" %>

              <div id="hamburger-menu" data-controller="menu", data-action="click->menu#openMenu">
                <div class="line"></div>
                <div class="line"></div>
                <div class="line"></div>
              </div>

              <div id="cart-icon" data-controller="cart" data-action="click->cart#openCart">
                <%= render "shared/cart_icon" %>
              </div>
            </div>
          
            <div id="menu">
              <ul>
                <li><a href="/admin/author">Authors</a></li>
                <li><a href="/admin/publishers">Publishers</a></li>
                <li><a href="/admin/books">Books</a></li>
                <li><a href="/catalog/index">Catalog</a></li>
                <li><a href="/about/index">About</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section id="main-content">
        <div id="content">
          <h1><%= "#{@page_title}" if @page_title %></h1>
          <% if flash[:notice] %>
            <div id="notice">
              <%= flash[:notice] %>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </section>

      <% if @cart %>
        <div id="shopping_cart">
          <%= render partial: "cart/cart" %>
        </div>
      <% end %>
    </main>

    <div id="footer">
      &copy; 2022-2023 Dream Library
    </div>
  </body>
</html>
